
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function approved() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && myProfile().status == "approved";
    }

    function superAdmin() {
      return approved()
        && myProfile().role == "superadmin";
    }

    function streamAdmin(stream) {
      return approved()
        && myProfile().role == "streamAdmin"
        && myProfile().stream == stream;
    }

    function canManageStream(stream) {
      return superAdmin() || streamAdmin(stream);
    }

    function validStream(stream) {
      return stream in [
        "Victors",
        "Heroes",
        "Winners",
        "Champions",
        "Archivers"
      ];
    }

    function validMessage(data) {
      return data.keys().hasAll([
          "senderId",
          "senderName",
          "text",
          "createdAt"
        ])
        && data.keys().hasOnly([
          "senderId",
          "senderName",
          "text",
          "createdAt",
          "stream"
        ])
        && data.senderId == request.auth.uid
        && data.senderName is string
        && data.senderName.size() > 0
        && data.senderName.size() <= 60
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 2000;
    }

    // STUDENT PROFILES
    match /users/{userId} {

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "name",
          "email",
          "stream",
          "role",
          "status",
          "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.email == request.auth.token.email
        && validStream(request.resource.data.stream)
        && request.resource.data.role == "member"
        && request.resource.data.status == "pending";

      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || superAdmin()
          || (
            approved()
            && streamAdmin(resource.data.stream)
          )
        );

      // Students can edit only their own name.
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(["name"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;

      // Admins can review pending registrations.
      allow update: if resource.data.status == "pending"
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            "status",
            "reviewedBy",
            "reviewedAt"
          ])
        && request.resource.data.status in [
          "approved",
          "rejected"
        ]
        && request.resource.data.reviewedBy == request.auth.uid
        && canManageStream(resource.data.stream);

      allow delete: if superAdmin();
    }

    // ANNOUNCEMENTS
    match /announcements/{announcementId} {

      allow read: if approved();

      allow create: if approved()
        && request.resource.data.stream is string
        && (
          request.resource.data.stream == "All"
          ? superAdmin()
          : validStream(request.resource.data.stream)
            && canManageStream(request.resource.data.stream)
        );

      allow update: if canManageStream(resource.data.stream)
        && request.resource.data.stream == resource.data.stream
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            "title",
            "body",
            "updatedAt"
          ]);

      allow delete: if canManageStream(resource.data.stream);
    }

    // STREAM CHAT
    match /messages/{messageId} {

      allow read: if approved()
        && resource.data.stream == myProfile().stream;

      allow create: if approved()
        && validStream(request.resource.data.stream)
        && request.resource.data.stream == myProfile().stream
        && validMessage(request.resource.data);

      allow update, delete: if false;
    }

    // SCHOOL-WIDE GROUP CHAT
    match /groupMessages/{messageId} {

      allow read: if approved();

      allow create: if approved()
        && validMessage(request.resource.data)
        && !("stream" in request.resource.data);

      allow update, delete: if false;
    }

    // PRIVATE CONVERSATIONS
    match /privateChats/{chatId} {

      function isParticipant() {
        return approved()
          && request.auth.uid in resource.data.participants;
      }

      allow create: if approved()
        && request.resource.data.keys().hasAll([
          "participants",
          "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "participants",
          "createdAt"
        ])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0]
          != request.resource.data.participants[1];

      allow read: if isParticipant();

      allow update, delete: if false;

      match /messages/{messageId} {

        function chatParticipant() {
          return approved()
            && request.auth.uid in get(
              /databases/$(database)/documents/privateChats/$(chatId)
            ).data.participants;
        }

        allow read: if chatParticipant();

        allow create: if chatParticipant()
          && validMessage(request.resource.data)
          && !("stream" in request.resource.data);

        allow update, delete: if false;
      }
    }

    // DENY EVERYTHING ELSE
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
