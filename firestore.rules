
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function approved() {
      return signedIn()
        && myProfile().status == "approved";
    }

    function superAdmin() {
      return approved()
        && myProfile().role == "superadmin";
    }

    function streamAdmin(stream) {
      return approved()
        && myProfile().role == "streamAdmin"
        && myProfile().stream == stream;
    }

    function canManageStream(stream) {
      return superAdmin() || streamAdmin(stream);
    }

    function validStream(stream) {
      return stream in [
        "Victors",
        "Heroes",
        "Winners",
        "Champions",
        "Archivers"
      ];
    }

    // USER PROFILES
    match /users/{userId} {

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "name",
          "email",
          "stream",
          "role",
          "status",
          "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.email == request.auth.token.email
        && validStream(request.resource.data.stream)
        && request.resource.data.role == "member"
        && request.resource.data.status == "pending";

      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || superAdmin()
          || (
            approved()
            && streamAdmin(resource.data.stream)
          )
        );

      // Students may edit only their own name.
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(["name"]);

      // Admins may review pending registrations.
      allow update: if
        resource.data.status == "pending"
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(["status", "reviewedBy", "reviewedAt"])
        && request.resource.data.status in ["approved", "rejected"]
        && request.resource.data.reviewedBy == request.auth.uid
        && canManageStream(resource.data.stream);

      // Only superadmin may delete profiles.
      allow delete: if superAdmin();
    }

    // ANNOUNCEMENTS
    match /announcements/{announcementId} {

      allow read: if approved();

      allow create: if approved()
        && request.resource.data.stream is string
        && (
          request.resource.data.stream == "All"
          ? superAdmin()
          : canManageStream(request.resource.data.stream)
        );

      allow update, delete: if
        canManageStream(resource.data.stream);
    }

    // STREAM CHAT
    match /messages/{messageId} {

      allow read: if approved()
        && resource.data.stream == myProfile().stream;

      allow create: if approved()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.stream == myProfile().stream
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;

      allow update, delete: if false;
    }

    // DENY EVERYTHING ELSE
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
